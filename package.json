{
  "name": "trail-planner-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "convex dev --start \"pnpm catalog:sync && node scripts/catalog-data/start-web-dev.mjs\"",
    "dev:web": "pnpm --filter @trail-planner/web dev",
    "convex:dev": "convex dev",
    "build": "pnpm catalog:check && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint scripts convex && pnpm -r lint",
    "test": "pnpm -r test && vitest run convex scripts/catalog-data",
    "test:e2e": "playwright test",
    "catalog:validate": "node scripts/catalog-data/validate-record.mjs",
    "catalog:compile": "node scripts/catalog-data/compile-catalog.mjs",
    "catalog:check": "node scripts/catalog-data/compile-catalog.mjs --check",
    "catalog:sync": "convex run ingest/catalogSync:synchronize",
    "catalog:validate-travel": "node scripts/catalog-data/validate-travel-data.mjs",
    "catalog:publish": "node scripts/catalog-data/publish-record.mjs",
    "cities:generate": "node scripts/catalog-data/generate-danish-cities.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "convex": "1.42.1",
    "convex-test": "0.0.54",
    "eslint": "10.0.1",
    "globals": "17.7.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  }
}
